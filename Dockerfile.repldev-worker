# Dockerfile for repldev - uses pre-built worker binary from Mac
FROM alpine:3.19

# Install runtime dependencies
RUN apk add --no-cache ca-certificates tzdata syft curl bash

# Install apko v0.27.6 (same version as builder pool)
RUN ARCH=$(uname -m | sed 's/x86_64/amd64/;s/aarch64/arm64/') && \
  curl -fsSL "https://github.com/chainguard-dev/apko/releases/download/v0.27.6/apko_0.27.6_linux_${ARCH}.tar.gz" -o /tmp/apko.tar.gz && \
  tar -xzf /tmp/apko.tar.gz -C /tmp && \
  mv /tmp/apko_0.27.6_linux_${ARCH}/apko /usr/bin/apko && \
  rm -rf /tmp/apko*

# Copy pre-built worker binary (built on Mac with GOOS=linux)
COPY bin/worker /usr/local/bin/worker

# Set working directory
WORKDIR /app

# Run worker
ENTRYPOINT ["/usr/local/bin/worker"]
CMD ["run"]
