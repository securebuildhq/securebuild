# Dockerfile for repldev - uses pre-built worker binary from Mac.
# Includes toolchain for build_backend=local (worker runs InstallBuildEnv + LocalRunner in-container).
FROM alpine:3.19

# Runtime deps: bubblewrap for melange; bash for install scripts; curl/tar via busybox
RUN apk add --no-cache ca-certificates tzdata syft curl bash bubblewrap

# melange v0.43.3 (keep in sync with localInstallMelangeVersion in pkg/builder/pool_install_local.go)
RUN ARCH=$(uname -m | sed 's/x86_64/amd64/;s/aarch64/arm64/') && \
  curl -fsSL "https://github.com/chainguard-dev/melange/releases/download/v0.43.3/melange_0.43.3_linux_${ARCH}.tar.gz" -o /tmp/melange.tar.gz && \
  tar -xzf /tmp/melange.tar.gz -C /tmp && \
  mv "/tmp/melange_0.43.3_linux_${ARCH}/melange" /usr/bin/melange && \
  chmod 0755 /usr/bin/melange && \
  rm -rf /tmp/melange*

# apko v0.27.6 (same version as builder pool)
RUN ARCH=$(uname -m | sed 's/x86_64/amd64/;s/aarch64/arm64/') && \
  curl -fsSL "https://github.com/chainguard-dev/apko/releases/download/v0.27.6/apko_0.27.6_linux_${ARCH}.tar.gz" -o /tmp/apko.tar.gz && \
  tar -xzf /tmp/apko.tar.gz -C /tmp && \
  mv /tmp/apko_0.27.6_linux_${ARCH}/apko /usr/bin/apko && \
  rm -rf /tmp/apko*

# grype (anchore install script; runs as root in image build)
RUN curl -sSfL https://raw.githubusercontent.com/anchore/grype/main/install.sh | sh -s -- -b /usr/bin

# Copy pre-built worker binary (built on Mac with GOOS=linux)
COPY bin/worker /usr/local/bin/worker

# Set working directory
WORKDIR /app

# Run worker
ENTRYPOINT ["/usr/local/bin/worker"]
CMD ["run"]
